# Production compose settings. The published UI binds to loopback by default.
# Set SYNAPSE_BIND_ADDRESS=0.0.0.0 only behind a configured TLS reverse proxy/firewall.
SYNAPSE_BIND_ADDRESS=127.0.0.1
SYNAPSE_PORT=8080

# Keep Ollama and FastAPI on the same host; Ollama is private to the Compose network.
OLLAMA_IMAGE=ollama/ollama:0.35.1
OLLAMA_MODEL=qwen2.5-coder:1.5b

# Same-origin UI/API needs no cross-origin browser access. Set explicit trusted origins
# only if the frontend is hosted on a different origin.
CORS_ALLOWED_ORIGINS=

# These paths must stay under the persistent /data volume in compose.yaml.
SYNAPSE_UPLOAD_DIR=/data/uploads
SYNAPSE_CHROMA_DIR=/data/chroma
MAX_PDF_UPLOAD_BYTES=26214400
MAX_PDF_PAGES=500
MAX_PDF_EXTRACTED_CHARS=5000000
